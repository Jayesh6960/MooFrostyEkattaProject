<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
        <style name="Base.Theme.MooFrosty" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/selector_nav_item</item>
        <item name="colorPrimaryVariant">@color/selector_nav_item</item>
        <item name="colorOnPrimary">@android:color/white</item>
        <item name="colorSurface">@color/white</item>
        <item name="android:statusBarColor">@color/Purple_Color</item>
        <item name="android:navigationBarColor">@android:color/white</item>

            <item name="textInputStyle">@style/MooTextInputLayout</item>

    </style>

    <style name="LoginTextInputLayoutStyle" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense">
        <item name="boxStrokeColor">@color/blue</item>
        <item name="boxStrokeWidth">1dp</item>
    </style>

    <style name="MooTextInputLayout" parent="Widget.MaterialComponents.TextInputLayout.FilledBox.Dense">
        <item name="hintTextColor">@color/orange</item>
        <item name="boxStrokeColor">@color/blue</item>
        <item name="boxStrokeWidth">1dp</item>
    </style>
    <style name="OutlinedButtonCustom" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:textColor">@color/black</item>
    </style>

    <style name="MyCustomTabText" parent="TextAppearance.Design.Tab">
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">14sp</item>
    </style>



    <style name="Theme.MooFrosty" parent="Base.Theme.MooFrosty" />

    <style name="CustomDatePickerTheme" parent="Theme.MaterialComponents.Light.Dialog">
        <item name="colorPrimary">@color/Purple_Color</item>
        <item name="colorAccent">@color/Purple_Color</item>


    </style>
</resources>