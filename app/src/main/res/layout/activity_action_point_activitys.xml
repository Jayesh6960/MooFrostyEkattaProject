<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:id="@+id/app_bar_layout"
        android:layout_height="wrap_content">
        <include
            android:id="@+id/laxmilayout"
            layout="@layout/toolbar_layout"/>
    </com.google.android.material.appbar.AppBarLayout>
        <!-- Header title and icons -->
        <!-- Stats Row -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/btn_qps_background"
            android:padding="8dp"
            >
            <!-- Left aligned text -->
            <TextView
                android:id="@+id/tv_esp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ESP : 0/0"
                android:textColor="@android:color/white"
                android:textStyle="bold"
                android:textSize="14sp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true" />
            <!-- Center aligned text -->
            <TextView
                android:id="@+id/tv_ta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TA : 0/0"
                android:textColor="@android:color/white"
                android:textStyle="bold"
                android:textSize="14sp"
                android:layout_centerInParent="true" />
            <!-- Right aligned text -->
            <TextView
                android:id="@+id/tv_tlsd"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TLSD : 0"
                android:textColor="@android:color/white"
                android:textStyle="bold"
                android:textSize="14sp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true" />
        </RelativeLayout>


    <!-- ✅ Scrollable content -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="12dp"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:text="Action Point"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAlignment="center"
                android:textStyle="bold"
                android:textSize="18sp"
                android:textColor="#1565C0"
                android:layout_marginBottom="12dp" />
            <!-- Outlet Creation Section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@android:color/white"
                android:padding="16dp"
                android:elevation="2dp"
                android:layout_marginBottom="16dp"
                android:layout_marginHorizontal="4dp">

                <TextView
                    android:text="Outlet creation date :"
                    android:textSize="14sp"
                    android:textColor="#424242"
                    android:layout_marginBottom="8dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:text="Choose PLG :"
                        android:textSize="14sp"
                        android:textColor="#616161"
                        android:layout_marginEnd="12dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>

                    <Spinner
                        android:id="@+id/spinner_plg"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:backgroundTint="#1565C0" />
                </LinearLayout>
            </LinearLayout>

            <!-- Sales -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@android:color/white"
                android:elevation="3dp"
                android:padding="12dp"
                android:layout_marginBottom="16dp">
                <TextView
                    android:text="Outlet Performance - Sales"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:textColor="#212121"
                    android:layout_marginBottom="4dp"
                    android:layout_height="wrap_content"
                    android:layout_width="wrap_content"/>
                <com.github.mikephil.charting.charts.BarChart
                    android:id="@+id/barChartSales"
                    android:layout_width="match_parent"
                    android:layout_height="220dp" />
            </LinearLayout>

            <!-- Assortment -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@android:color/white"
                android:elevation="4dp"
                android:padding="12dp"
                android:layout_margin="12dp">
                <TextView
                    android:id="@+id/tv_title_assortment"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Outlet Performance - Assortment"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:textColor="#0D47A1"
                    android:layout_marginBottom="8dp" />
                <com.github.mikephil.charting.charts.BarChart
                    android:id="@+id/barChartAssortment"
                    android:layout_width="match_parent"
                    android:layout_height="220dp"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="8dp" />
            </LinearLayout>
            <!-- Table Section -->
            <TableLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#E3F2FD"
                android:stretchColumns="*"
                android:layout_margin="8dp"
                android:padding="2dp">

                <TableRow>
                    <TextView
                        android:text="PARAM"
                        android:padding="8dp"
                        android:gravity="center"
                        android:textStyle="bold"
                        android:textColor="@android:color/white"
                        android:background="@drawable/btn_qps_background_nocorner" />

                    <TextView
                        android:text="MOC TGT"
                        android:padding="8dp"
                        android:gravity="center"
                        android:textStyle="bold"
                        android:textColor="@android:color/white"
                        android:background="@drawable/btn_qps_background_nocorner"/>

                    <TextView
                        android:text="MOC ACH"
                        android:padding="8dp"
                        android:gravity="center"
                        android:textStyle="bold"
                        android:textColor="@android:color/white"
                        android:background="@drawable/btn_qps_background_nocorner" />

                    <TextView
                        android:text="BTD"
                        android:padding="8dp"
                        android:gravity="center"
                        android:textStyle="bold"
                        android:textColor="@android:color/white"
                        android:background="@drawable/btn_qps_background" />
                </TableRow>

                <TableRow>
                    <TextView
                        android:text="Others"
                        android:padding="8dp"
                        android:gravity="center"
                        android:layout_weight="1" />

                    <TextView
                        android:text="67"
                        android:padding="8dp"
                        android:gravity="center" />

                    <TextView
                        android:text="67"
                        android:padding="8dp"
                        android:gravity="center" />

                    <TextView
                        android:text="0"
                        android:padding="8dp"
                        android:gravity="center" />
                </TableRow>
            </TableLayout>
            <!-- Buttons -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginBottom="16dp">
                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btn_qps"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="QPS"
                    android:textColor="@color/white"
                    android:background="@drawable/btn_qps_background"
                android:layout_marginEnd="8dp" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btn_btpr"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="BTPR"
                    android:background="@drawable/btn_qps_background"
                android:textColor="@android:color/white" />
            </LinearLayout>
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_next"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Next"
                android:textColor="#C72F66"
                android:textSize="20sp"
                android:background="@drawable/btn_back_stroke"
                android:textAllCaps="false"
                android:layout_marginBottom="32dp" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>