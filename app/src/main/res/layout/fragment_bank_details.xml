<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.attendance.profile.BankDetailsFragment">


<com.google.android.material.card.MaterialCardView
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_margin="16dp"
    app:cardElevation="4dp"
    app:cardCornerRadius="12dp"
    android:backgroundTint="@color/white"
    tools:context=".ui.attendance.profile.BankDetailsFragment">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="8dp">

                    <com.google.android.material.imageview.ShapeableImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/bankdetails"
                        app:shapeAppearanceOverlay="@style/ShapeAppearance.MaterialComponents.SmallComponent"
                        android:tint="?attr/colorOnSurface" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="Bank Details"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="?attr/colorOnSurface"
                        android:paddingStart="8dp"
                        android:layout_weight="1" />

<!--                    <com.google.android.material.imageview.ShapeableImageView-->
<!--                        android:id="@+id/penicon"-->
<!--                        android:layout_width="24dp"-->
<!--                        android:layout_height="24dp"-->
<!--                        android:src="@drawable/penicon"-->
<!--                        android:tint="?attr/colorOnSurface"-->
<!--                        android:contentDescription="@string/penicon"-->
<!--                        android:visibility="gone"/>-->

                </LinearLayout>

            </LinearLayout>

            <!-- Bank Name -->
            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Bank Name *"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_marginTop="8dp">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etBankName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clickable="false"
                    android:enabled="false"
                    android:inputType="text"
                    android:text="Cosmos Bank"
                    android:textColor="#3E3E3E"
                    android:textStyle="bold" />
            </com.google.android.material.textfield.TextInputLayout>
<!---->
            <!-- Branch Name -->
            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Branch Name *"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_marginTop="16dp">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etBranchName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Jalna road"
                    android:inputType="text"
                    android:clickable="false"
                    android:textStyle="bold"
                    android:textColor="#3E3E3E"
                    android:enabled="false" />
            </com.google.android.material.textfield.TextInputLayout>



            <!-- Account Number -->
            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Account Number *"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_marginTop="16dp">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etAccountNumber"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="0180501095442"
                    android:textStyle="bold"
                    android:textColor="#3E3E3E"
                    android:clickable="false"
                    android:enabled="false"
                    android:inputType="number" />
            </com.google.android.material.textfield.TextInputLayout>



            <!-- Confirm Account Number -->
            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Confirm Account Number *"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_marginTop="16dp">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etConfirmAccountNumber"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="************"
                    android:textStyle="bold"
                    android:clickable="false"
                    android:textColor="#3E3E3E"
                    android:enabled="false"
                    android:inputType="textPassword" />
            </com.google.android.material.textfield.TextInputLayout>



            <!-- IFSC Code -->
            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="IFSC Code *"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_marginTop="16dp">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etIFSCCode"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="COSB0000018"
                    android:inputType="textCapCharacters"
                    android:textStyle="bold"
                    android:textColor="#3E3E3E"
                    android:clickable="false"
                    android:enabled="false" />
            </com.google.android.material.textfield.TextInputLayout>



            <!-- Account Type -->
            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Account Type *"
                android:layout_marginTop="16dp"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                app:endIconMode="dropdown_menu">

                <com.google.android.material.textfield.MaterialAutoCompleteTextView
                    android:id="@+id/spinnerAccountType"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="none"
                    android:text="Saving Account"
                    android:textColor="#3E3E3E"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:clickable="false"
                    android:enabled="false"
                    android:padding="16dp" />
            </com.google.android.material.textfield.TextInputLayout>
            <LinearLayout
                android:id="@+id/layoutactivity"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="end"
                android:clickable="false"
                android:visibility="gone"
                android:layout_marginTop="16dp"
                android:spacing="8dp"
                android:padding="8dp"
                tools:ignore="DuplicateIds">

                <!-- Save Button -->
                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnSave"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Save"
                    android:backgroundTint="@color/blue"
                    android:textColor="@android:color/white"
                    android:layout_marginEnd="8dp"/>

                <!-- Cancel Button -->
                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnCancel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Cancel"
                    android:backgroundTint="@color/grey2"
                    android:textColor="@android:color/white"/>
            </LinearLayout>


        </LinearLayout>

        </ScrollView>

    </com.google.android.material.card.MaterialCardView >

    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="center"
        android:visibility="gone" />

</FrameLayout>