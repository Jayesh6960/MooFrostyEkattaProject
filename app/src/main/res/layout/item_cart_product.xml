<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="1dp">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <FrameLayout
            android:id="@+id/image_layout"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true">

            <ImageView
                android:id="@+id/img_product_cart"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                tools:src="@drawable/icecategori" />

            <TextView
                android:id="@+id/tv_item_savings_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="#D32F2F"
                android:textColor="@android:color/white"
                android:textSize="10sp"
                android:textStyle="bold"
                android:padding="4dp"
                android:layout_gravity="top|start"
                tools:text="₹145 SAVED"/>
        </FrameLayout>

        <TextView
            android:id="@+id/tv_product_name_cart"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_toEndOf="@id/image_layout"
            android:layout_toStartOf="@id/btn_delete_cart"
            android:layout_marginStart="12dp"
            android:textColor="@android:color/black"
            android:textStyle="bold"
            tools:text="Bis American Dry Nuts Bulk 4000ml" />

        <TextView
            android:id="@+id/tv_rate_cart"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/tv_product_name_cart"
            android:layout_alignStart="@id/tv_product_name_cart"
            android:layout_marginTop="4dp"
            android:textColor="@android:color/black"
            tools:text="₹725" />

        <TextView
            android:id="@+id/tv_mrp_cart"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignBottom="@id/tv_rate_cart"
            android:layout_toEndOf="@id/tv_rate_cart"
            android:layout_marginStart="8dp"
            tools:text="₹870" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/tv_rate_cart"
            android:layout_alignStart="@id/tv_product_name_cart"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btn_unit_minus_cart"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_baseline_remove_24" />

            <TextView
                android:id="@+id/tv_unit_quantity_cart"
                android:layout_width="40dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="1"
                android:textSize="18sp"
                android:textStyle="bold" />
            <ImageButton
                android:id="@+id/btn_unit_plus_cart"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_baseline_add_24" />
        </LinearLayout>
        <ImageButton
            android:id="@+id/btn_delete_cart"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_alignParentTop="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_baseline_delete_24"
            app:tint="#D32F2F" />
    </RelativeLayout>
</com.google.android.material.card.MaterialCardView>