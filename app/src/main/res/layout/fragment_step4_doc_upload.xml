<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="20dp"
    tools:context=".ui.newstorecreation.Step4DocUploadFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_doc_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Document Upload"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="10dp" />

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:boxStrokeColor="@color/Purple_Color"
            app:hintTextColor="@color/Purple_Color"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:hint="Document Number">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_doc_number"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Upload Document Image" />

        <ImageView
            android:id="@+id/img_doc"
            android:layout_width="match_parent"
            android:layout_height="150dp"
            android:background="#EEE"
            android:scaleType="centerInside"
            android:src="@android:drawable/ic_menu_camera" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Upload Shop Board (Outside)" />

        <ImageView
            android:id="@+id/img_board"
            android:layout_width="match_parent"
            android:layout_height="150dp"
            android:background="#EEE"
            android:scaleType="centerInside"
            android:src="@android:drawable/ic_menu_camera" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Upload Shop Inside" />

        <ImageView
            android:id="@+id/img_inside"
            android:layout_width="match_parent"
            android:layout_height="150dp"
            android:background="#EEE"
            android:scaleType="centerInside"
            android:src="@android:drawable/ic_menu_camera" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_submit"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="30dp"
            android:layout_marginBottom="50dp"
            android:backgroundTint="@color/Pink_color"
            android:text="Submit" />

    </LinearLayout>

</androidx.core.widget.NestedScrollView>