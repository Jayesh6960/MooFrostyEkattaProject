        <com.google.android.material.appbar.AppBarLayout
            android:id="@+id/app_bar_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toTopOf="parent">

            <include
                android:id="@+id/main_toolbar"
                layout="@layout/toolbar_layout_drawabletab" />

        </com.google.android.material.appbar.AppBarLayout>


        <com.google.android.material.tabs.TabLayout
            android:id="@+id/tabLayout"
            android:layout_width="match_parent"
            android:layout_height="65dp"
            app:tabMode="fixed"
            app:tabGravity="fill"
            app:tabIndicatorFullWidth="true"
            app:tabIndicatorColor="@color/Purple_Color"
            app:tabSelectedTextColor="@color/Purple_Color"
            app:tabIndicatorHeight="3dp"
            android:elevation="5dp"
            app:tabRippleColor="?attr/colorPrimary"
            app:tabTextAppearance="@style/MyCustomTabText"
            app:tabIconTint="@color/Purple_Color"
            app:tabTextColor="@color/black">

            <com.google.android.material.tabs.TabItem
                android:text="Details"
                android:icon="@drawable/details"
                android:layout_height="wrap_content"
                android:outlineAmbientShadowColor="@color/Purple_Color"
                android:layout_width="0dp"/>

            <com.google.android.material.tabs.TabItem
                android:text="Bank"
                android:icon="@drawable/bankdetails"
                android:layout_height="wrap_content"
                android:outlineAmbientShadowColor="@color/Purple_Color"
                android:layout_width="0dp"/>

        </com.google.android.material.tabs.TabLayout>


