<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:background="#F5F5F5"
    tools:context=".ui.dashboard.DashboardMyBeatFragment">

    <!-- 1. Horizontal Calendar -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/calendar_recycler"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="5dp"
        android:paddingBottom="5dp"
        android:background="#E2E2E2"
        />

    <!-- 2. Beat Dropdown -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:padding="12dp"
        android:layout_marginTop="1dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tv_beat_dropdown"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Beat: Select"
            android:textSize="14sp"
            android:textStyle="bold"
            android:drawableEnd="@drawable/ic_baseline_keyboard_arrow_down_24"
            android:drawableTint="@color/black"/>
    </LinearLayout>

    <!-- 3. Summary Cards -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="8dp"
        android:weightSum="3">

        <!-- Order Value Card -->
        <androidx.cardview.widget.CardView
            android:layout_width="0dp"
            android:layout_height="80dp"
            android:layout_weight="1"
            app:cardCornerRadius="8dp"
            app:cardBackgroundColor="#80CBC4"
            android:layout_marginEnd="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center_horizontal|center_vertical">

                <TextView
                    android:text="Order Value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="15sp"
                    android:textColor="@color/black"/>

                <TextView
                    android:id="@+id/tv_order_val"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="2574"

                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/black"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Visited Card -->
        <androidx.cardview.widget.CardView
            android:layout_width="0dp"
            android:layout_height="80dp"
            android:layout_weight="1"
            app:cardCornerRadius="8dp"
            app:cardBackgroundColor="#F48FB1"
            android:layout_marginEnd="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center_horizontal|center_vertical">

                <TextView
                    android:text="Stores Visited"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="15sp"
                    android:textColor="@color/black"/>/>

                <TextView
                    android:id="@+id/tv_visited_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="13/40"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/black"/>/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Order Taken Card -->
        <androidx.cardview.widget.CardView
            android:layout_width="0dp"
            android:layout_height="80dp"
            android:layout_weight="1"
            app:cardCornerRadius="8dp"
            app:cardBackgroundColor="#90CAF9">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center_horizontal|center_vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Order Taken"
                    android:textSize="15sp"
                    android:textColor="@color/black"/>/>

                <TextView
                    android:id="@+id/tv_order_taken_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="8/40"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/black"/>/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </LinearLayout>

    <!-- 4. Search and Map -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="8dp"
        android:gravity="center_vertical">

        <EditText
            android:id="@+id/et_search"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:background="@drawable/rounded_edittext_bg"
            android:hint="40 Store(s)"
            android:paddingStart="12dp"
            android:drawableStart="@android:drawable/ic_menu_search"
            android:drawableTint="@android:color/darker_gray"
            android:textSize="14sp"/>

        <ImageView
            android:id="@+id/btn_map_view"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginStart="8dp"
            android:src="@android:drawable/ic_dialog_map"
            app:tint="#2196F3" /> <!-- The Map Button -->
    </LinearLayout>

