<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5"
    tools:context=".ui.enterstoreorders.ordersdetails.OrderDetailsActivity">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/app_bar_layout"
        android:layout_width="match_parent"
        android:layout_alignParentTop="true"
        android:layout_height="wrap_content"
        android:visibility="visible">

        <include
            android:id="@+id/main_toolbar"
            layout="@layout/toolbar_layout" />

    </com.google.android.material.appbar.AppBarLayout>

        <LinearLayout
            android:id="@+id/info_bar"
            android:layout_width="match_parent"
            android:layout_height="35dp"
            android:layout_below="@id/app_bar_layout"
            android:background="@drawable/btn_qps_background"
            android:orientation="horizontal"
            android:padding="8dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:visibility="gone"
                android:text="@string/esp_0_0"
                android:textColor="@android:color/white"
                android:textStyle="bold" />
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:visibility="gone"
                android:text="@string/ta_0_0"
                android:textColor="@android:color/white"
                android:textStyle="bold" />
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:visibility="gone"
                android:text="@string/tlsd_0"
                android:textColor="@android:color/white"
                android:textStyle="bold" />
        </LinearLayout>
    <FrameLayout
        android:id="@+id/confirm_return_bar"
        android:layout_width="match_parent"
        android:visibility="gone"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="@android:color/white"
       >
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_confirm_return"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="Confirm Return"
            android:textColor="@color/white"
            android:textAllCaps="false"
            android:textStyle="bold"
            android:textSize="17dp"
            android:background="@drawable/btn_qps_background"/>
    </FrameLayout>
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/info_bar"
        android:layout_above="@id/confirm_return_bar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <TextView
                            android:id="@+id/tv_salesperson_title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Salesperson Orders"
                            android:textColor="@android:color/black"
                            android:textStyle="bold"
                            android:textSize="17dp"
                            android:layout_alignParentStart="true"/>
                        <ImageView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:src="@drawable/orderprofile"
                            app:tint="#4CAF50"
                            android:layout_alignParentEnd="true"/>
                    </RelativeLayout>

                    <TextView
                        android:id="@+id/tv_status_text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="  Billed"
                        android:drawableTint="#4CAF50"
                        android:drawablePadding="8dp"
                        android:textColor="#4CAF50"
                        android:textSize="18dp"
                        android:textStyle="bold"
                        android:gravity="end"
                        android:layout_marginTop="8dp"/>
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#E0E0E0"
                        android:layout_marginTop="8dp"
                        />


                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="10dp">
                        <TextView
                            android:layout_width="130dp"
                            android:layout_height="wrap_content"
                            android:textStyle="bold"
                            android:textSize="16dp"
                            android:text="Order Amount"/>
                        <TextView
                            android:id="@+id/tv_bill_amount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            tools:text=":  ₹7,757.55"
                            android:textSize="16dp"
                            android:textColor="@android:color/black"
                            android:textStyle="bold"/>
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#E0E0E0"
                        android:layout_marginTop="8dp" />

                    <LinearLayout
                        android:id="@+id/ordernolayout"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:visibility="visible"
                        android:layout_marginTop="8dp">
                        <TextView
                            android:layout_width="130dp"
                            android:layout_height="wrap_content"
                            android:textStyle="bold"
                            android:textSize="16dp"
                            android:text="Order No  "/>
                        <TextView
                            android:id="@+id/tv_order_no"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="16dp"
                            tools:text=""
                            android:textColor="@android:color/black"
                            android:textStyle="bold"/>
                    </LinearLayout>


                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="View Order Details"
                        android:textColor="@color/Pink_color"
                        android:textStyle="bold"
                        android:visibility="gone"
                        android:drawableEnd="@drawable/ic_baseline_keyboard_arrow_down_24"
                        android:drawableTint="@color/Pink_color"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="16dp"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:id="@+id/Invoicewieitesm"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="8dp">

            <LinearLayout
                android:id="@+id/invoicenolayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Invoice Number : "
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_invoiceno"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=" "
                    android:textStyle="bold"/>
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recycler_order_items"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

        </LinearLayout>
            </LinearLayout>

    </androidx.core.widget.NestedScrollView>
</RelativeLayout>